APP_NAME=Medical RAG Assistant
APP_VERSION=0.1.0
API_V1_PREFIX=/api/v1

DEBUG=True
HOST=127.0.0.1
PORT=8000

DATABASE_URL=sqlite:///medical_rag.db

JWT_SECRET_KEY=change_this_to_a_long_random_secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

UPLOAD_DIRECTORY=../data/uploads
MAX_UPLOAD_SIZE_MB=50
ALLOWED_EXTENSIONS=pdf,docx,txt,md

GEMINI_API_KEY=AQ.Ab8RN6LBAXFP8L6Hv5QXFt1ay8BWciiFM5DbZ3ZjI3F4hnhccA

EMBEDDING_PROVIDER=gemini
EMBEDDING_MODEL=gemini-embedding-2
EMBEDDING_DIMENSION=768
EMBEDDING_BATCH_SIZE=32

CHUNK_SIZE=1000
CHUNK_OVERLAP=200

VECTOR_STORE_PROVIDER=qdrant
VECTOR_COLLECTION_NAME=medical_knowledge
VECTOR_DISTANCE=cosine
VECTOR_TOP_K=5

FAISS_INDEX_PATH=../data/vectorstore/faiss.index
FAISS_METADATA_PATH=../data/vectorstore/faiss_metadata.json

QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=uv run python -m app.ai.vectorstore.test_faiss
RERANKER_PROVIDER=cross_encoder
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L6-v2

RERANKER_CANDIDATE_K=20
RERANKER_TOP_K=5
RERANKER_MAX_LENGTH=512
LLM_PROVIDER=gemini
LLM_MODEL=gemini-2.5-flash

LLM_TEMPERATURE=0.1
LLM_MAX_OUTPUT_TOKENS=2048
JWT_SECRET_KEY=your_long_random_secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
GEMINI_MODEL=gemini-2.5-flash